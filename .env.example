# Optional. If ANTHROPIC_API_KEY is set, Case Compass uses Claude for intake
# questions, case analysis, role-play, and reports. If it is left unset, the
# app automatically falls back to a fully self-contained rule-based engine
# (see src/ai/rulesEngine.js) - no key required, no external calls, no risk
# of a live-demo network/rate-limit failure.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Defaults to 3000.
PORT=3000
